---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
---
<Base title="二次関数グラフ実験室"><PageIntro eyebrow="MATH VISUAL LAB" title="二次関数グラフ実験室" description="a・b・cを変えて、放物線の形・頂点・判別式の関係を観察します。" number="∑"/><section class="panel"><div class="math-grid"><div class="math-controls"><label for="a">a</label><input id="a" type="number" value="1" step=".5"/><label for="b">b</label><input id="b" type="number" value="-2" step=".5"/><label for="c">c</label><input id="c" type="number" value="-3" step=".5"/><output id="info" aria-live="polite"></output></div><svg id="graph" viewBox="0 0 600 420" role="img" aria-label="二次関数のグラフ"><rect width="600" height="420" rx="14" fill="#f5f9fd"/><g id="grid"></g><path id="curve" fill="none" stroke="#6d28d9" stroke-width="3"/></svg></div></section></Base>
<style>.math-grid{display:grid;grid-template-columns:220px 1fr;gap:25px}.math-controls{display:grid;gap:12px;align-content:start}.math-controls input{width:100%}.math-controls output{white-space:pre-line;line-height:2}.math-grid svg{width:100%;height:auto}@media(max-width:700px){.math-grid{grid-template-columns:1fr}}</style>
<script>
const el=id=>document.getElementById(id),g=el('grid'),ns='http://www.w3.org/2000/svg';for(let x=0;x<=600;x+=30){const p=document.createElementNS(ns,'line');p.setAttribute('x1',x);p.setAttribute('x2',x);p.setAttribute('y1',0);p.setAttribute('y2',420);p.setAttribute('stroke',x===300?'#63758d':'#dce6f0');g.append(p)}for(let y=0;y<=420;y+=30){const p=document.createElementNS(ns,'line');p.setAttribute('x1',0);p.setAttribute('x2',600);p.setAttribute('y1',y);p.setAttribute('y2',y);p.setAttribute('stroke',y===210?'#63758d':'#dce6f0');g.append(p)}function render(){const [a,b,c]=['a','b','c'].map(id=>Number(el(id).value));if(![a,b,c].every(Number.isFinite)||['a','b','c'].some(id=>el(id).value==='')){el('info').textContent='数値を入力してください';el('curve').setAttribute('d','');return}const points=[];for(let px=0;px<=600;px+=2){const x=(px-300)/30,y=a*x*x+b*x+c;points.push((px===0?'M':'L')+px+' '+(210-y*30))}el('curve').setAttribute('d',points.join(' '));const d=b*b-4*a*c;el('info').textContent='判別式 D = '+d.toFixed(2)+(a!==0?'\n頂点：(' +(-b/(2*a)).toFixed(2)+', '+(c-b*b/(4*a)).toFixed(2)+')':'\na=0なので直線です')}['a','b','c'].forEach(id=>el(id).addEventListener('input',render));render();
</script>