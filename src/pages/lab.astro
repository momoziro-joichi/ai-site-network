---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import {curricula} from '../config/curricula.mjs';
const key=process.env.SITE_KEY||'weather',data=curricula[key],base=import.meta.env.BASE_URL.replace(/\/$/,'');
const experiments={weather:[['気塊の上昇と雲底','/simulator/','気温・湿度・高度の関係を観察'],['天気図読解ワークスペース','/chart-studio/','気圧配置と前線を描き込む'],['記述式実技演習','/written-practice/','架空の資料を読み取り記述する'],['高低気圧の模式図','/weather-map/','気圧差と等圧線の関係を試す']],math:[['二次関数の可視化','/math-visualizer/','係数と放物線の関係を確認'],['行列・線形変換','/linear-algebra/','行列式と格子の変形を観察'],['二次方程式の解','/tool/','判別式と解を計算']],rail:[['速度・時間グラフ','/rail-performance/','加減速を視覚的に比較'],['時刻表モデル','/rail-timetable/','駅間距離と停車時分を積算'],['駅間走行時間','/tool/','停車時間を含むモデルを試算']],english:[['接客英語トレーナー','/english-practice/','12のフレーズを繰り返し練習'],['状況別判断演習','/english-scenarios/','適切な接客表現を選ぶ'],['袋の確認クイズ','/tool/','接客の基本表現を確認']],tools:[['文章チェック','/text-workbench/','入力しながら文字数を計測'],['理工系単位換算','/unit-converter/','温度・速度・圧力・長さを換算'],['文字数カウンター','/tool/','バイト数・行数を確認']]};
---
<Base title="実験室"><PageIntro eyebrow="INTERACTIVE LAB" title="実験室" description={data.description} number="◎"/><div class="experiments">{experiments[key].map(([title,path,description],i)=><a class="panel experiment" href={base+path}><span>EXPERIMENT {String(i+1).padStart(2,'0')}</span><h2>{title}</h2><p>{description}</p><strong>実験を開く ↗</strong></a>)}</div></Base>
<style>.experiments{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.experiment{margin:0;min-height:230px;text-decoration:none;transition:transform .2s}.experiment:hover{transform:translateY(-4px)}.experiment span{color:var(--accent);font-size:.7rem;font-weight:800;letter-spacing:.14em}.experiment h2{margin:18px 0 10px}.experiment p{font-size:.85rem;color:var(--muted);line-height:1.9}.experiment strong{font-size:.83rem;color:var(--accent)}@media(max-width:700px){.experiments{grid-template-columns:1fr}}</style>