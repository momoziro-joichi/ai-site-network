---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
---
<Base title="接客英語・状況別判断トレーニング"><PageIntro eyebrow="SERVICE ENGLISH" title="接客英語・状況別判断トレーニング" description="接客場面を読み、適切な英語表現を選ぶ練習です。表現の丁寧さと意味を確認します。" number="Aa"/><section class="panel"><label for="scenario">場面</label><select id="scenario"><option value="bag">袋の確認</option><option value="repeat">聞き返し</option><option value="heat">温め</option><option value="pay">支払い方法</option><option value="stock">在庫切れ</option></select><h2 id="prompt"></h2><div id="options" class="options"></div><output id="feedback" aria-live="polite"></output><button id="next" type="button">次の場面</button><p class="note">選択肢は学習用の例です。実際の接客では店舗の方針や状況に合わせて言い換えてください。</p></section></Base>
<style>.options{display:grid;gap:12px;margin:20px 0}.options button{text-align:left;padding:15px}.note{font-size:.8rem;color:var(--muted)}#feedback{display:block;min-height:70px;white-space:pre-line;line-height:1.8}</style>
<script>
const cases=[{id:'bag',prompt:'お客様にレジ袋が必要か確認したい。',options:['Do you need a bag?','Where did you buy this?','Do you have a bag for me?'],answer:0,why:'Do you need a bag? は袋が必要かを尋ねる自然な表現です。'},{id:'repeat',prompt:'お客様の言葉が聞き取れなかった。',options:['Speak louder.','Could you say that again, please?','I do not listen.'],answer:1,why:'Could you ... please? は丁寧な依頼の形です。'},{id:'heat',prompt:'お弁当を温めるか確認したい。',options:['Do you burn it?','Would you like me to heat it up?','Is it very hot now?'],answer:1,why:'Would you like me to ...? は店員が行う行為の希望を丁寧に確認できます。'},{id:'pay',prompt:'支払い方法を確認したい。',options:['How would you like to pay?','Why are you paying?','Where is your money?'],answer:0,why:'How would you like to pay? は支払い方法の希望を尋ねます。'},{id:'stock',prompt:'商品が品切れであることを伝えたい。',options:['It is broken forever.','We have too many.','I’m sorry, we’re out of stock.'],answer:2,why:'We’re out of stock. は在庫切れを意味します。'}];const sel=document.getElementById('scenario'),opts=document.getElementById('options'),feedback=document.getElementById('feedback');function render(){const c=cases.find(x=>x.id===sel.value);document.getElementById('prompt').textContent=c.prompt;feedback.textContent='';opts.replaceChildren();c.options.forEach((s,i)=>{const b=document.createElement('button');b.type='button';b.textContent=s;b.addEventListener('click',()=>{feedback.textContent=(i===c.answer?'正解。':'不正解。')+'\n'+c.why+'\n正答：'+c.options[c.answer]});opts.append(b)})}sel.addEventListener('change',render);document.getElementById('next').addEventListener('click',()=>{sel.selectedIndex=(sel.selectedIndex+1)%cases.length;render()});render();
</script>