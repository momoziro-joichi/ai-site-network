---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
const phrases=[['袋は必要ですか？','Do you need a bag?','bag'],['温めますか？','Would you like me to heat it up?','heat'],['お支払い方法は？','How would you like to pay?','pay'],['レシートは必要ですか？','Would you like a receipt?','receipt'],['少々お待ちください。','Just a moment, please.','wait'],['もう一度言っていただけますか？','Could you say that again, please?','repeat'],['こちらでお召し上がりですか？','Will you eat here?','eat'],['お箸は必要ですか？','Would you like chopsticks?','chopsticks'],['申し訳ありません。在庫がありません。',"I'm sorry, we're out of stock.",'stock'],['こちらにお並びください。','Please line up here.','line'],['合計で500円です。','Your total is 500 yen.','total'],['ありがとうございました。','Thank you. Have a nice day!','thanks']];
---
<Base title="コンビニ接客英語トレーナー"><PageIntro eyebrow="REAL WORLD ENGLISH" title="コンビニ接客英語トレーナー" description="12の接客場面で、意味を理解してから英語を思い出す練習をします。" number="Aa"/><section class="panel trainer"><div class="trainer-head"><span id="progress">1 / 12</span><button id="shuffle" type="button">順番をシャッフル</button></div><p class="question" id="japanese"></p><button id="reveal" type="button">英語を表示する</button><div class="english" id="english" aria-live="polite"></div><div class="trainer-actions"><button id="again" type="button">もう一度</button><button id="next" type="button">次のフレーズ →</button></div><p class="muted">音声認識や発音採点はありません。英文の暗記と意味の確認に使う学習カードです。</p></section></Base>
<style>.trainer{max-width:760px;margin:0 auto}.trainer-head,.trainer-actions{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.trainer-head span{font-weight:800;color:var(--accent)}.question{font-size:clamp(1.4rem,4vw,2.1rem);font-weight:800;margin:35px 0}.english{font-size:1.25rem;font-weight:700;min-height:100px;padding:20px 0;color:var(--accent)}.trainer-actions{justify-content:flex-start}.muted{font-size:.8rem;margin-top:25px}</style>
<script define:vars={{phrases}}>
let order=phrases.map((_,i)=>i),i=0;const jp=document.getElementById('japanese'),en=document.getElementById('english'),pr=document.getElementById('progress');function render(){jp.textContent=phrases[order[i]][0];en.textContent='';pr.textContent=(i+1)+' / '+order.length}document.getElementById('reveal').addEventListener('click',()=>en.textContent=phrases[order[i]][1]);document.getElementById('next').addEventListener('click',()=>{i=(i+1)%order.length;render()});document.getElementById('again').addEventListener('click',render);document.getElementById('shuffle').addEventListener('click',()=>{for(let j=order.length-1;j>0;j--){const k=Math.floor(Math.random()*(j+1));[order[j],order[k]]=[order[k],order[j]]}i=0;render()});render();
</script>