---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
---
<Base title="列車ダイヤ・区間走行時間モデル"><PageIntro eyebrow="TIMETABLE ENGINEERING" title="列車ダイヤ・区間走行時間モデル" description="複数の駅間距離・最高速度・停車時間を入力し、加減速を考慮した理論時刻表を作成します。" number="↗"/><section class="panel"><label for="distances">駅間距離（km、カンマ区切り）</label><input id="distances" value="8,12,6" placeholder="8,12,6"/><div class="controls"><label>最高速度（km/h）<input id="speed" type="number" value="120" min="1"/></label><label>加速度（m/s²）<input id="accel" type="number" value="0.6" step=".1" min=".01"/></label><label>減速度（m/s²）<input id="decel" type="number" value="0.7" step=".1" min=".01"/></label><label>途中停車（秒）<input id="dwell" type="number" value="45" min="0"/></label><label>出発時刻<input id="departure" type="time" value="09:00"/></label></div><button id="calculate" type="button">時刻表を計算</button><output id="status" aria-live="polite"></output><div id="results"></div><p class="note">すべての駅で停止する仮定です。各区間は一定加減速度・最高速度で計算し、曲線制限、勾配、信号、余裕時分、ダイヤ上の制約を含みません。</p></section></Base>
<style>.controls{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:15px 0}.controls label{display:grid;gap:8px;font-size:.8rem}.controls input,#distances{width:100%}#results{overflow:auto;margin-top:20px}table{width:100%;border-collapse:collapse}th,td{padding:12px;border-bottom:1px solid var(--line);text-align:left}.note{font-size:.78rem;color:var(--muted);margin-top:20px}@media(max-width:700px){.controls{grid-template-columns:1fr 1fr}}</style>
<script>
import {journey} from '../lib/science.mjs';
const el=id=>document.getElementById(id);function render(){const out=el('results');out.replaceChildren();try{const ds=el('distances').value.split(',').map(x=>Number(x.trim()));if(!ds.length||ds.length>30||ds.some(x=>!Number.isFinite(x)||x<=0))throw Error('区間距離は正の数値を1〜30個入力してください');const [speed,accel,decel,dwell]=['speed','accel','decel','dwell'].map(id=>Number(el(id).value));if([speed,accel,decel,dwell].some(x=>!Number.isFinite(x))||dwell<0)throw Error('入力値を確認してください');const departure=el('departure').value;if(!/^\d{2}:\d{2}$/.test(departure))throw Error('出発時刻を入力してください');let t=Number(departure.slice(0,2))*3600+Number(departure.slice(3))*60;const fmt=s=>{const m=Math.floor(s/60);return String(Math.floor(m/60)%24).padStart(2,'0')+':'+String(m%60).padStart(2,'0')+':'+String(Math.floor(s%60)).padStart(2,'0')+(m>=1440?' (+翌日)':'')};const table=document.createElement('table'),head=document.createElement('tr');['区間','距離','走行時間','到着時刻','次駅出発'].forEach(x=>{const th=document.createElement('th');th.textContent=x;head.append(th)});table.append(head);let sum=0;ds.forEach((d,i)=>{const j=journey(d,speed,accel,decel);sum+=j.seconds;t+=j.seconds;const arrival=fmt(t),next=i===ds.length-1?'終着':fmt(t+dwell);if(i<ds.length-1)t+=dwell;const tr=document.createElement('tr');[i+1,d+'km',(j.seconds/60).toFixed(2)+'分',arrival,next].forEach(x=>{const td=document.createElement('td');td.textContent=x;tr.append(td)});table.append(tr)});out.append(table);el('status').textContent='走行時間合計 '+(sum/60).toFixed(2)+'分／停車時間込み '+((sum+(ds.length-1)*dwell)/60).toFixed(2)+'分'}catch(e){el('status').textContent=e.message}}el('calculate').addEventListener('click',render);render();
</script>