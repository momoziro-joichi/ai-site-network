---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
---
<Base title="天気図モデル"><PageIntro eyebrow="PRESSURE FIELD LAB" title="天気図モデル" description="高気圧・低気圧の位置と強さを変えて、仮想的な等圧線を観察します。" number="H"/><section class="panel"><div class="map-grid"><div class="controls"><label for="kind">気圧系</label><select id="kind"><option value="low">低気圧（L）</option><option value="high">高気圧（H）</option></select><label for="strength">中心と周囲の気圧差（hPa） <output id="strength-value">24</output></label><input id="strength" type="range" min="4" max="40" step="2" value="24"/><label for="posx">東西位置</label><input id="posx" type="range" min="80" max="520" value="300"/><label for="posy">南北位置</label><input id="posy" type="range" min="60" max="340" value="200"/><p class="muted">モデル：基準気圧1013 hPa、円形ガウス分布。実際の天気図ではありません。</p></div><div class="map-view"><svg id="map" viewBox="0 0 600 400" role="img" aria-label="等圧線の模式図"><rect width="600" height="400" fill="#eef6fc" rx="16"/><g id="isobars"></g><text id="center-label" x="300" y="200" text-anchor="middle" font-size="32" font-weight="bold" fill="#124a79">L</text></svg><output id="pressure" aria-live="polite"></output></div></div></section></Base>
<style>.map-grid{display:grid;grid-template-columns:260px 1fr;gap:30px}.controls{display:grid;gap:12px;align-content:start}.controls label{font-size:.85rem}.controls input,.controls select{width:100%}.map-view svg{width:100%;height:auto}.map-view output{font-size:.88rem}.muted{font-size:.77rem;line-height:1.8}@media(max-width:750px){.map-grid{grid-template-columns:1fr}}</style>
<script>
const el=id=>document.getElementById(id);const svgNS='http://www.w3.org/2000/svg';
function render(){const high=el('kind').value==='high',amp=Number(el('strength').value),x=Number(el('posx').value),y=Number(el('posy').value),g=el('isobars');g.replaceChildren();for(let i=1;i<=5;i++){const delta=i*4;if(delta>amp)break;const radius=130*Math.sqrt(-2*Math.log(delta/amp));if(!Number.isFinite(radius))continue;const c=document.createElementNS(svgNS,'circle');c.setAttribute('cx',x);c.setAttribute('cy',y);c.setAttribute('r',radius);c.setAttribute('fill','none');c.setAttribute('stroke',high?'#bc7042':'#2877ac');c.setAttribute('stroke-width','1.7');g.append(c)}const t=el('center-label');t.setAttribute('x',x);t.setAttribute('y',y+10);t.textContent=high?'H':'L';el('strength-value').textContent=amp;el('pressure').textContent='中心気圧：'+(1013+(high?amp:-amp))+' hPa（仮想モデル）'}
for(const id of ['kind','strength','posx','posy'])el(id).addEventListener('input',render);render();
</script>