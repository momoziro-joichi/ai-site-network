---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import {caseStudies} from '../data/weather-case-studies.mjs';
---
<Base title="気象予報士・記述式実技演習"><PageIntro eyebrow="WRITTEN FORECAST PRACTICE" title="気象予報士・記述式実技演習" description="架空の観測・予報資料を使い、事実を読み取り、根拠を示して短く記述する練習です。" number="✎"/><section class="panel"><p>気象業務支援センターが公表する実技試験の科目（気象概況、局地予想、台風等緊急時）に対応する独自の導入演習です。公式過去問ではなく、本番の難度・採点基準を再現していません。</p><a href="https://www.jmbsc.or.jp/jp/examination/examination-2.html" target="_blank" rel="noopener noreferrer">出題範囲の一次資料 ↗</a></section><div class="cases">{caseStudies.map((c,i)=><section class="panel case"><p class="eyebrow">CASE {String(i+1).padStart(2,'0')} / {c.topic}</p><h2>{c.title}</h2><p class="source">{c.source}</p><h3>与えられた資料</h3><ul>{c.facts.map(f=><li>{f}</li>)}</ul>{c.questions.map((q,j)=><div class="task"><h3>設問 {j+1}</h3><p>{q.prompt}</p><label for={'answer-'+i+'-'+j}>あなたの解答</label><textarea id={'answer-'+i+'-'+j} rows="3" placeholder="事実と根拠を簡潔に記述"></textarea><details><summary>模範解答と考え方を表示</summary><p><strong>解答例：</strong>{q.model}</p><p><strong>考え方：</strong>{q.reason}</p></details></div>)}</section>)}</div></Base>
<style>.cases{display:grid;gap:20px}.case{margin:0}.eyebrow{color:var(--accent);font-size:.72rem;font-weight:800;letter-spacing:.12em}.source{font-size:.78rem;color:var(--muted)}.task{border-top:1px solid var(--line);margin-top:20px;padding-top:20px}.task label{display:block;font-size:.8rem;font-weight:700}.task textarea{display:block;width:100%;margin:8px 0 15px}.task details{background:var(--accent-light);padding:15px;border-radius:12px}.task summary{cursor:pointer;font-weight:700}.task details p{font-size:.86rem;line-height:1.9}</style>