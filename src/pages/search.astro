---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
const key=process.env.SITE_KEY||'weather';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
import {curricula} from '../config/curricula.mjs';
const extra={weather:[['記述式実技演習','/written-practice/','気象予報士 記述式 局地 台風'],['公式天気図','/official-charts/','実況天気図 予想天気図'],['天気図読解スタジオ','/chart-studio/','前線 高気圧 低気圧 書き込み'],['最新予報','/live-weather/','気象庁 府県天気予報']],math:[['行列・線形変換','/linear-algebra/','行列式 ベクトル 線形代数'],['二次関数グラフ','/math-visualizer/','放物線 判別式 係数']],rail:[['時刻表モデル','/rail-timetable/','停車時分 駅間距離 ダイヤ'],['鉄道走行性能ラボ','/rail-performance/','加速度 減速度 速度グラフ']],english:[['状況別判断演習','/english-scenarios/','コンビニ 英語 接客'],['接客英語トレーナー','/english-practice/','コンビニ フレーズ']],tools:[['単位換算','/unit-converter/','温度 圧力 速度'],['文章チェック','/text-workbench/','文字数 UTF-8 バイト数']]};
const items=[['ホーム','/','サイトのトップページ'],['計算ツール','/tool/','計算や英語練習'],['実験室','/lab/','実験と学習'],['学習ガイド','/guide/','基礎解説'],...(key==='weather'?[['気象教科書','/learn/','気圧 湿度 前線 天気図'],['確認問題','/quiz/','気象予報士 練習'],['気塊シミュレーター','/simulator/','露点 雲底'],['天気図モデル','/weather-map/','高気圧 低気圧 等圧線'],['雲の実験室','/cloud-lab/','雲 断熱変化 気温 湿度']]:[]),...extra[key]];
---
<Base title="サイト内検索"><PageIntro eyebrow="SITE SEARCH" title="サイト内検索" description="ページ名やキーワードから、このサイトの機能を探せます。" number="⌕"/><section class="panel"><label for="query">検索キーワード</label><input id="query" type="search" placeholder="例：気圧、計算、問題" autocomplete="off"/><p id="count" class="muted" aria-live="polite"></p><div id="results" class="results">{items.map(([title,path,desc])=><a class="result" data-keywords={(title+' '+desc).toLowerCase()} href={base+path}><strong>{title}</strong><span>{desc} ↗</span></a>)}</div></section></Base>
<style>input{display:block;width:100%;margin:10px 0 16px}.results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.result{padding:17px;border:1px solid var(--line);border-radius:12px;text-decoration:none;display:grid;gap:5px}.result:hover{background:var(--accent-light)}.result span{font-size:.8rem;color:var(--muted)}.result[hidden]{display:none}@media(max-width:650px){.results{grid-template-columns:1fr}}</style>
<script>
const q=document.getElementById('query'),rows=[...document.querySelectorAll('.result')],count=document.getElementById('count');const filter=()=>{const term=q.value.trim().toLowerCase();let n=0;rows.forEach(x=>{const visible=x.dataset.keywords.includes(term);x.hidden=!visible;if(visible)n++});count.textContent=n+' 件のページが見つかりました'};q.addEventListener('input',filter);filter();
</script>