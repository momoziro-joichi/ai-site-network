---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
---
<Base title="最新の気象情報"><PageIntro eyebrow="JMA LIVE FORECAST" title="最新の気象情報" description="気象庁が公開する府県予報データを取得し、実際の予報文を表示します。" number="☁"/><section class="panel"><div class="live-toolbar"><label for="region">表示地域</label><select id="region"><option value="260000">京都府</option><option value="250000">滋賀県</option><option value="270000">大阪府</option><option value="280000">兵庫県</option><option value="130000">東京都</option><option value="010000">北海道（石狩・空知・後志）</option></select><button id="load" type="button">最新データを取得</button></div><output id="status" aria-live="polite">取得待ち</output><div id="forecast" class="forecast-grid"></div><p class="muted">気象庁の予報JSONをブラウザから直接取得します。データ提供側の仕様・通信制限によって取得できない場合があります。これは観測値や実況天気図ではなく、気象庁の天気予報です。</p></section><section class="panel"><h2>実際の天気図を見る</h2><p>等圧線や前線を確認する場合は、気象庁が公開する天気図を参照してください。</p><a href="https://www.jma.go.jp/bosai/weather_map/" target="_blank" rel="noopener noreferrer">気象庁「天気図」公式ページ ↗</a><p class="muted">このサイトの「天気図モデル」は架空の気圧場を描く教材であり、公式天気図とは異なります。</p></section></Base>
<style>.live-toolbar{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:20px}.live-toolbar select{min-width:220px}.forecast-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:18px}.forecast-card{border:1px solid var(--line);border-radius:14px;padding:20px;background:var(--surface)}.forecast-card h3{font-size:1rem}.forecast-card p{white-space:pre-wrap;color:var(--muted);font-size:.88rem}.muted{font-size:.79rem;margin-top:20px}@media(max-width:650px){.forecast-grid{grid-template-columns:1fr}}</style>
<script>
const select=document.getElementById('region'),status=document.getElementById('status'),box=document.getElementById('forecast'),button=document.getElementById('load');
async function load(){button.disabled=true;status.textContent='気象庁からデータ取得中…';box.replaceChildren();try{const id=select.value;const response=await fetch('https://www.jma.go.jp/bosai/forecast/data/forecast/'+id+'.json',{cache:'no-store'});if(!response.ok)throw Error('HTTP '+response.status);const data=await response.json();const report=data?.[0];const series=report?.timeSeries?.[0];if(!series?.areas?.length)throw Error('予報データの形式が変わった可能性があります');const times=series.timeDefines||[];for(const area of series.areas){const card=document.createElement('article');card.className='forecast-card';const h=document.createElement('h3');h.textContent=area.area?.name||'地域';card.append(h);for(let i=0;i<Math.min(times.length,3);i++){const p=document.createElement('p');const date=String(times[i]||'').replace('T',' ').slice(0,16);p.textContent=date+'：'+(area.weathers?.[i]||'予報文なし');card.append(p)}box.append(card)}status.textContent='気象庁発表：'+String(report.reportDatetime||'時刻不明').replace('T',' ').slice(0,16)+' ／ 出典：気象庁（府県天気予報）'}catch(e){status.textContent='取得できませんでした。通信状態または提供形式を確認してください。';const a=document.createElement('a');a.href='https://www.jma.go.jp/bosai/forecast/';a.textContent='気象庁公式の天気予報を開く ↗';a.target='_blank';a.rel='noopener noreferrer';box.append(a)}finally{button.disabled=false}}
button.addEventListener('click',load);load();
</script>