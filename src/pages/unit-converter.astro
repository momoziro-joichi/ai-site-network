---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
---
<Base title="理工系単位換算ツール"><PageIntro eyebrow="ENGINEERING CONVERTER" title="理工系単位換算ツール" description="温度・速度・圧力・長さを、定義に基づいて換算します。" number="↔"/><section class="panel"><label for="kind">換算する量</label><select id="kind"><option value="temperature">温度（℃ ↔ K）</option><option value="speed">速度（m/s ↔ km/h）</option><option value="pressure">圧力（hPa ↔ Pa）</option><option value="distance">長さ（km ↔ m）</option></select><div class="converter"><label for="value">数値<input id="value" type="number" step="any" value="20"/></label><label for="direction">換算方向<select id="direction"><option value="forward">左 → 右</option><option value="reverse">右 → 左</option></select></label></div><output id="result" aria-live="polite"></output><p class="note">換算係数は定義値を使用。温度換算では絶対零度未満の値を入力エラーとします。</p></section></Base>
<style>.converter{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:18px 0}.converter label{display:grid;gap:8px}.converter input,.converter select{width:100%}#result{display:block;font-size:1.4rem;font-weight:800;color:var(--accent);margin:25px 0}.note{font-size:.8rem;color:var(--muted)}@media(max-width:650px){.converter{grid-template-columns:1fr}}</style>
<script>
const el=id=>document.getElementById(id),defs={temperature:['℃','K',x=>x+273.15,x=>x-273.15],speed:['m/s','km/h',x=>x*3.6,x=>x/3.6],pressure:['hPa','Pa',x=>x*100,x=>x/100],distance:['km','m',x=>x*1000,x=>x/1000]};function render(){const d=defs[el('kind').value],reverse=el('direction').value==='reverse',s=el('value').value,x=Number(s);if(s===''||!Number.isFinite(x)){el('result').textContent='数値を入力してください';return}const y=d[reverse?3:2](x);if(el('kind').value==='temperature'&&(reverse?x<0:y<0)){el('result').textContent='絶対零度未満の値は扱えません';return}el('result').textContent=x+' '+d[reverse?1:0]+' = '+Number(y.toPrecision(12))+' '+d[reverse?0:1]}['kind','direction','value'].forEach(id=>el(id).addEventListener('input',render));render();
</script>