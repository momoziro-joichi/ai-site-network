---
import Base from '../layouts/Base.astro';
const key=process.env.SITE_KEY||'weather';
---
<Base><h1>無料ツール</h1><section class="panel"><div class="tool">{key==='weather'?<><label>気温（℃）<input id="v1" type="number" value="20"/></label><button id="go">華氏に変換</button></>:key==='math'?<><p>二次方程式 ax²+bx+c=0</p><label>a<input id="v1" type="number" value="1"/></label><label>b<input id="v2" type="number" value="-3"/></label><label>c<input id="v3" type="number" value="2"/></label><button id="go">解を計算</button></>:key==='rail'?<><label>距離（km）<input id="v1" type="number" value="100"/></label><label>最高速度（km/h）<input id="v2" type="number" value="120"/></label><button id="go">簡易所要時間</button></>:key==='english'?<><p>「袋は必要ですか？」を英語で言うと？</p><select id="v1"><option value="0">Do you need a bag?</option><option value="1">Where is the bag?</option></select><button id="go">採点</button></>:<><label>入力テキスト<textarea id="v1" rows="7">こんにちは</textarea></label><button id="go">文字数を計算</button></>}<output id="result" aria-live="polite"></output></div></section><p class="muted">簡易モデルです。重要な判断には使わないでください。</p></Base>
<script>
import {quadratic,journey,textStats} from '../lib/science.mjs';
const key=import.meta.env.SITE_KEY||'weather';const el=(id)=>document.getElementById(id);el('go')?.addEventListener('click',()=>{try{const a=el('v1')?.value,b=el('v2')?.value,c=el('v3')?.value;let out;if(key==='weather')out=(Number(a)*9/5+32).toFixed(2)+' °F';else if(key==='math')out=JSON.stringify(quadratic(Number(a),Number(b),Number(c)));else if(key==='rail'){const j=journey(Number(a),Number(b));out=(j.seconds/60).toFixed(2)+' 分（停車・勾配なし）'}else if(key==='english')out=a==='0'?'正解！ Do you need a bag?':'不正解。正解は Do you need a bag?';else out=JSON.stringify(textStats(a),null,2);el('result').textContent=out}catch(e){el('result').textContent='入力値を確認してください'}})
</script>