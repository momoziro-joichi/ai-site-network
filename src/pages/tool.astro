---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
const key=process.env.SITE_KEY||'weather';
const titles={weather:'温度変換',math:'二次方程式ソルバー',rail:'所要時間シミュレーター',english:'接客英語クイズ',tools:'文字数カウンター'};
const descriptions={weather:'摂氏から華氏へ。気温の単位をすばやく変換します。',math:'係数を入力すると、判別式と解を計算します。',rail:'距離・最高速度・加減速から、停車を除いた理論的な所要時間を推定します。',english:'コンビニで使う定番の英語表現を練習しましょう。',tools:'文字数・行数・単語数・UTF-8バイト数を確認できます。'};
---
<Base title={titles[key]}><PageIntro eyebrow="INTERACTIVE TOOL" title={titles[key]} description={descriptions[key]} number="↗"/><div class="workspace"><section class="panel workspace-form"><div class="step-label">01 / INPUT</div><h2>条件を入力</h2><div class="tool">{key==='weather'?<><label for="v1">気温（℃）</label><input id="v1" type="number" value="20" step="any"/></>:key==='math'?<><p class="equation">ax² + bx + c = 0</p><label for="v1">係数 a</label><input id="v1" type="number" value="1" step="any"/><label for="v2">係数 b</label><input id="v2" type="number" value="-3" step="any"/><label for="v3">係数 c</label><input id="v3" type="number" value="2" step="any"/></>:key==='rail'?<><label for="v1">距離（km）</label><input id="v1" type="number" min="0" value="100" step="any"/><label for="v2">最高速度（km/h）</label><input id="v2" type="number" min="1" value="120" step="any"/></>:key==='english'?<><p class="question">「袋は必要ですか？」を英語で言うと？</p><label for="v1">正しい表現を選択</label><select id="v1"><option value="0">Do you need a bag?</option><option value="1">Where is the bag?</option></select></>:<><label for="v1">テキストを入力</label><textarea id="v1" rows="8">こんにちは</textarea></>}<button id="go" data-site={key} type="button">計算・確認する <span aria-hidden="true">↗</span></button></div></section><section class="panel workspace-result"><div class="step-label">02 / RESULT</div><h2>計算結果</h2><div class="result-surface"><div class="result-icon" aria-hidden="true">✳</div><output id="result" aria-live="polite">左側の条件を入力して、ボタンを押してください。</output></div><p class="muted caution">※ 教育・参考用途の簡易ツールです。重要な判断には使用しないでください。</p></section></div></Base>
<style>
.workspace{display:grid;grid-template-columns:1fr 1fr;gap:22px;align-items:start}.workspace .panel{margin:0;min-height:360px}.step-label{font-size:.72rem;letter-spacing:.15em;color:var(--accent);font-weight:800}.workspace h2{font-size:1.3rem;margin:12px 0 25px}.tool{gap:11px}.tool label{font-size:.83rem;color:#52647c}.tool input,.tool textarea,.tool select{width:100%;border:1px solid #d8e2ed;background:#f9fbfe}.tool button{margin-top:13px;display:flex;justify-content:space-between}.equation{font-size:1.25rem;font-weight:800;text-align:center;background:#f4f7fb;border-radius:12px;padding:14px}.question{font-weight:700}.result-surface{background:linear-gradient(135deg,color-mix(in srgb,var(--accent) 9%,white),#f8fafc);border:1px solid #e8edf4;border-radius:16px;min-height:205px;padding:26px;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:13px}.result-icon{width:42px;height:42px;background:white;color:var(--accent);border-radius:12px;display:grid;place-items:center;font-size:1.5rem}.result-surface output{font-size:1.12rem;color:#203148;overflow-wrap:anywhere;margin:0}.caution{font-size:.76rem;line-height:1.8;margin:18px 0 0}@media(max-width:760px){.workspace{grid-template-columns:1fr}.workspace .panel{min-height:0}.result-surface{min-height:160px}}
</style>
<script>
import {quadratic,journey,textStats} from '../lib/science.mjs';
const go=document.getElementById('go');const key=go?.dataset.site||'weather';const el=id=>document.getElementById(id);
go?.addEventListener('click',()=>{try{const a=el('v1')?.value,b=el('v2')?.value,c=el('v3')?.value;let out;if(key==='weather'){if(a==='')throw Error('empty');out=(Number(a)*9/5+32).toFixed(2)+' °F'}else if(key==='math'){if([a,b,c].some(x=>x===''))throw Error('empty');const q=quadratic(Number(a),Number(b),Number(c));out=q.roots?'判別式 D = '+q.discriminant+'\n解：'+q.roots.map(x=>Number(x.toPrecision(12))).join('、'):'判別式 D = '+q.discriminant+'\n解：'+q.real.toPrecision(6)+' ± '+q.imag.toPrecision(6)+'i'}else if(key==='rail'){if(a===''||b==='')throw Error('empty');const j=journey(Number(a),Number(b));out=(j.seconds/60).toFixed(2)+' 分\n到達最高速度：'+j.peakKmh.toFixed(1)+' km/h'}else if(key==='english'){out=a==='0'?'正解！\nDo you need a bag?':'不正解。\n正解：Do you need a bag?'}else{const s=textStats(a);out='文字数：'+s.characters+'\n行数：'+s.lines+'\n単語数：'+s.words+'\nUTF-8：'+s.bytes+' バイト'}el('result').textContent=out}catch(e){el('result').textContent='入力値を確認してください'}})
</script>