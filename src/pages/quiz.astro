---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import {questions} from '../data/weather-questions.mjs';
const categories=['すべて','一般','専門','実技基礎'];
---
<Base title="気象予報士試験・オリジナル演習"><PageIntro eyebrow="WEATHER EXAM PRACTICE" title="気象予報士試験・演習問題" description="一般・専門・実技基礎のオリジナル問題100問（計算反復問題を含む）。分野を選んで採点し、解説で復習できます。" number="?"/><section class="panel"><div class="quiz-toolbar"><label for="category">分野</label><select id="category">{categories.map(x=><option value={x}>{x}</option>)}</select><label for="count">出題数</label><select id="count"><option value="5">5問</option><option value="10">10問</option><option value="20">20問</option><option value="50">50問</option><option value="100">最大100問</option></select><button type="button" id="new-quiz">問題を作成</button></div><p class="muted">公式過去問の転載ではありません。100問のうち76問は数値を変えた計算反復問題です。試験本番の出題傾向を再現した問題集ではありません。</p></section><form id="quiz" class="quiz-form"><div id="questions"></div><button type="submit" id="grade">採点して解説を見る</button><output id="score" aria-live="polite"></output></form><section class="panel"><h2>公式過去問について</h2><p>実際の試験問題・解答例は、<a href="https://www.jmbsc.or.jp/jp/examination/examination-7.html" target="_blank" rel="noopener noreferrer">気象業務支援センターの公式ページ</a>で確認してください。無断転載を避けるため、このサイトでは公式問題を複製していません。</p></section></Base>
<style>.quiz-toolbar{display:flex;flex-wrap:wrap;gap:12px;align-items:center}.quiz-toolbar select{min-width:130px}.quiz-toolbar button{padding:11px 16px}.quiz-form{max-width:850px;margin:25px auto}.question-card{margin:0 0 16px}.question-card h2{font-size:1.13rem}.question-tag{font-size:.72rem;color:var(--accent);font-weight:800;letter-spacing:.08em}.choices{display:grid;gap:10px}.choice{display:flex;gap:12px;align-items:center;border:1px solid var(--line);padding:12px;border-radius:12px;cursor:pointer}.choice:has(input:checked){background:var(--accent-light);border-color:var(--accent)}.explanation{border-left:3px solid var(--accent);padding:12px 15px;margin-top:16px;background:var(--accent-light);border-radius:8px}.explanation[hidden]{display:none}#grade{padding:14px 25px}#score{padding:14px 0}.muted{font-size:.82rem}</style>
<script define:vars={{bank:questions}}>
const container=document.getElementById('questions'),grade=document.getElementById('grade'),score=document.getElementById('score');let active=[];
function make(){const cat=document.getElementById('category').value,count=Number(document.getElementById('count').value);const pool=bank.filter(q=>cat==='すべて'||q.section===cat);active=pool.slice().sort(()=>Math.random()-.5).slice(0,count);container.replaceChildren();score.textContent='';grade.disabled=false;for(const [i,q] of active.entries()){const card=document.createElement('section');card.className='panel question-card';const tag=document.createElement('div');tag.className='question-tag';tag.textContent=q.section+' / '+q.topic+' / '+q.id;const h=document.createElement('h2');h.textContent=(i+1)+'. '+q.question;const opts=document.createElement('div');opts.className='choices';q.choices.forEach((s,j)=>{const label=document.createElement('label');label.className='choice';const input=document.createElement('input');input.type='radio';input.name=q.id;input.value=j;label.append(input,document.createTextNode(s));opts.append(label)});const exp=document.createElement('div');exp.className='explanation';exp.hidden=true;exp.textContent='正解：'+q.choices[q.answer]+'。 '+q.explanation;card.append(tag,h,opts,exp);container.append(card)}}
document.getElementById('new-quiz').addEventListener('click',make);document.getElementById('category').addEventListener('change',make);
document.getElementById('quiz').addEventListener('submit',e=>{e.preventDefault();const data=new FormData(e.currentTarget);let correct=0;active.forEach((q,i)=>{if(Number(data.get(q.id))===q.answer&&data.has(q.id))correct++;container.children[i].querySelector('.explanation').hidden=false});score.textContent=active.length+'問中 '+correct+'問正解（未回答は不正解）';grade.disabled=true;try{const key='ai-site-network-quiz-history';const old=JSON.parse(localStorage.getItem(key)||'[]');localStorage.setItem(key,JSON.stringify([{date:new Date().toISOString(),section:document.getElementById('category').value,correct,total:active.length},...old].slice(0,50)))}catch{}});
make();
</script>