---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
const qs=[['乾燥断熱減率の代表値は？',['約9.8 ℃/km','約1 ℃/km','約30 ℃/km'],0],['相対湿度100%とは？',['空気が水だけになる','水蒸気圧が飽和水蒸気圧に等しい','雨が必ず降る'],1],['気圧のSI単位は？',['パスカル','ジュール','ワット'],0],['風向の北風とは？',['北へ吹く','北から吹く','北半球だけの風'],1]];
---
<Base title="気象の確認問題"><PageIntro eyebrow="WEATHER QUIZ" title="気象の確認問題" description="基礎知識を4問のミニクイズで確認しましょう。" number="?"/><form class="quiz-form" id="quiz">{qs.map(([q,opts],i)=><fieldset class="panel quiz-card"><legend class="sr-only">問題 {i+1}</legend><span class="question-no">QUESTION {String(i+1).padStart(2,'0')}</span><h2>{q}</h2><div class="answers">{opts.map((o,j)=><label class="answer"><input type="radio" name={'q'+i} value={j}/><span>{o}</span></label>)}</div></fieldset>)}<div class="quiz-submit"><button type="submit">採点する ↗</button><output id="score" aria-live="polite">すべて回答したら採点してください。</output></div></form></Base>
<style>.quiz-form{max-width:830px;margin:auto}.quiz-card{margin:0 0 17px;padding:28px}.question-no{font-size:.7rem;font-weight:800;color:var(--accent);letter-spacing:.15em}.quiz-card h2{font-size:1.14rem;margin:12px 0 22px}.answers{display:grid;gap:10px}.answer{display:flex;gap:12px;align-items:center;background:#f8fafc;border:1px solid #e6edf4;border-radius:12px;padding:13px 15px;cursor:pointer;font-size:.89rem}.answer:has(input:checked){background:var(--accent-light);border-color:var(--accent)}.answer input{accent-color:var(--accent)}.quiz-submit{display:flex;gap:20px;align-items:center;flex-wrap:wrap;margin-top:25px}.quiz-submit button{padding:13px 28px}.quiz-submit output{color:#52647c;font-size:.9rem;margin:0}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}</style>
<script define:vars={{answers:qs.map(q=>q[2])}}>
document.getElementById('quiz')?.addEventListener('submit',e=>{e.preventDefault();const data=new FormData(e.currentTarget);if(answers.some((_,i)=>data.get('q'+i)===null)){document.getElementById('score').textContent='すべての問題に回答してください。';return}let score=0;answers.forEach((a,i)=>{if(Number(data.get('q'+i))===a)score++});document.getElementById('score').textContent=score+' / '+answers.length+' 問正解'})
</script>