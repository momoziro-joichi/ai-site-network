---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
---
<Base title="2×2行列・線形変換ラボ"><PageIntro eyebrow="LINEAR ALGEBRA STUDIO" title="2×2行列・線形変換ラボ" description="行列が平面上の格子とベクトルをどのように変換するかを観察します。" number="A"/><section class="panel"><div class="lab"><div class="inputs"><p>変換行列 A</p><div class="matrix"><input id="a" type="number" value="1" step=".25" aria-label="a11"/><input id="b" type="number" value=".5" step=".25" aria-label="a12"/><input id="c" type="number" value="0" step=".25" aria-label="a21"/><input id="d" type="number" value="1" step=".25" aria-label="a22"/></div><output id="result" aria-live="polite"></output><p class="hint">det(A)=ad−bc。行列式が0なら変換後の面積は0になり、逆行列は存在しません。</p></div><svg viewBox="0 0 620 420" role="img" aria-label="線形変換の格子"><rect width="620" height="420" fill="#f7faff"/><g id="original" stroke="#d5e1ef" stroke-width="1"></g><g id="transformed" stroke="#2563eb" stroke-width="1.5"></g><path id="basis1" stroke="#dc2626" stroke-width="4" fill="none"/><path id="basis2" stroke="#059669" stroke-width="4" fill="none"/></svg></div></section></Base>
<style>.lab{display:grid;grid-template-columns:230px 1fr;gap:25px}.matrix{display:grid;grid-template-columns:1fr 1fr;gap:10px}.matrix input{width:100%}.inputs output{display:block;white-space:pre-line;margin:20px 0;font-weight:700}.hint{font-size:.82rem;line-height:1.8}svg{width:100%;height:auto;border:1px solid var(--line);border-radius:14px}@media(max-width:700px){.lab{grid-template-columns:1fr}}</style>
<script>
const ns='http://www.w3.org/2000/svg',el=id=>document.getElementById(id),center=[310,210],scale=35;function line(parent,x1,y1,x2,y2){const l=document.createElementNS(ns,'line');l.setAttribute('x1',center[0]+scale*x1);l.setAttribute('y1',center[1]-scale*y1);l.setAttribute('x2',center[0]+scale*x2);l.setAttribute('y2',center[1]-scale*y2);parent.append(l)}for(let i=-9;i<=9;i++){line(el('original'),i,-6,i,6);line(el('original'),-9,i,9,i)}function render(){const ids=['a','b','c','d'];if(ids.some(id=>el(id).value===''))return;const [a,b,c,d]=ids.map(id=>Number(el(id).value));if(![a,b,c,d].every(Number.isFinite))return;const det=a*d-b*c,trans=el('transformed');trans.replaceChildren();const f=(x,y)=>[a*x+b*y,c*x+d*y];for(let i=-9;i<=9;i++){let p=f(i,-6),q=f(i,6);line(trans,...p,...q);p=f(-9,i);q=f(9,i);line(trans,...p,...q)}el('basis1').setAttribute('d','M310 210 L'+(310+scale*a)+' '+(210-scale*c));el('basis2').setAttribute('d','M310 210 L'+(310+scale*b)+' '+(210-scale*d));el('result').textContent='det(A) = '+det.toFixed(3)+'\n面積倍率 = '+Math.abs(det).toFixed(3)+(Math.abs(det)<1e-10?'\n逆行列なし':'\n逆行列あり')}['a','b','c','d'].forEach(id=>el(id).addEventListener('input',render));render();
</script>