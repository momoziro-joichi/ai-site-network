---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
---
<Base title="文章チェックワークベンチ"><PageIntro eyebrow="TEXT WORKBENCH" title="文章チェックワークベンチ" description="文字数、改行、空白、UTF-8容量を一度に確認します。文章はサーバーへ送信しません。" number="✦"/><section class="panel"><label for="source">チェックする文章</label><textarea id="source" rows="12" placeholder="ここに文章を入力してください"></textarea><div class="stats"><div><strong id="codepoints">0</strong><span>コードポイント数</span></div><div><strong id="no-spaces">0</strong><span>空白除外</span></div><div><strong id="lines">0</strong><span>行数</span></div><div><strong id="bytes">0</strong><span>UTF-8バイト</span></div></div><button id="copy" type="button">文章をコピー</button><output id="message" aria-live="polite"></output><p class="muted">絵文字などは表示上1文字でも複数コードポイントになることがあります。文字数制限のある提出先の仕様と一致するとは限りません。</p></section></Base>
<style>textarea{width:100%;margin-top:10px}.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:18px 0}.stats>div{background:var(--accent-light);border-radius:14px;padding:20px 10px;text-align:center}.stats strong{display:block;font-size:1.7rem;color:var(--accent)}.stats span{font-size:.75rem;color:var(--muted)}.muted{font-size:.79rem;margin-top:20px}@media(max-width:700px){.stats{grid-template-columns:repeat(2,1fr)}}</style>
<script>
const input=document.getElementById('source');function render(){const t=input.value;document.getElementById('codepoints').textContent=[...t].length;document.getElementById('no-spaces').textContent=[...t].filter(c=>!(/\s/u).test(c)).length;document.getElementById('lines').textContent=t===''?0:t.split(/\r\n|\r|\n/).length;document.getElementById('bytes').textContent=new TextEncoder().encode(t).length}input.addEventListener('input',render);document.getElementById('copy').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(input.value);document.getElementById('message').textContent='コピーしました'}catch{document.getElementById('message').textContent='コピーできませんでした'}});render();
</script>