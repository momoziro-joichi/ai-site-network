---
import Base from '../layouts/Base.astro';
---
<Base><h1>気塊シミュレーター</h1><p>気温・相対湿度から露点と推定雲底を計算します。</p><section class="panel tool"><label>地上気温（℃）<input id="temp" type="number" value="25"/></label><label>相対湿度（%）<input id="rh" type="number" value="70" min="1" max="100"/></label><button id="simulate">計算</button><output id="result" aria-live="polite"></output><svg id="chart" viewBox="0 0 500 250" role="img" aria-label="高度に対する気温の概略グラフ"><rect width="500" height="250" fill="#f0f7ff"/><polyline id="curve" points="" fill="none" stroke="#0369a1" stroke-width="3"/></svg></section><p class="muted">乾燥断熱減率9.8 ℃/km、雲底近似125 m/℃、雲底上は固定6 ℃/kmの教育用モデル。実際の大気予測には使用できません。</p></Base>
<script>
import {parcelProfile,dewPoint} from '../lib/weather.mjs';
document.getElementById('simulate')?.addEventListener('click',()=>{const t=Number(document.getElementById('temp').value),rh=Number(document.getElementById('rh').value);try{const p=parcelProfile(t,rh);document.getElementById('result').textContent='露点 '+dewPoint(t,rh).toFixed(1)+' ℃ / 推定雲底 '+p.lclM.toFixed(0)+' m';const pts=p.points.map(x=>[40+(t-x.tempC)*8,220-x.heightM/5000*190]);document.getElementById('curve').setAttribute('points',pts.map(p=>p.join(',')).join(' '))}catch(e){document.getElementById('result').textContent='入力値を確認してください'}})
</script>