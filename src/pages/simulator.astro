---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
---
<Base title="気塊シミュレーター"><PageIntro eyebrow="ATMOSPHERE SIMULATOR" title="気塊シミュレーター" description="地上の気温と相対湿度を変えて、露点・推定雲底・気温の鉛直変化を観察します。" number="☁"/><div class="sim-grid"><section class="panel sim-controls"><span class="kicker">01 / PARAMETERS</span><h2>大気の条件</h2><label for="temp">地上気温（℃）</label><input id="temp" type="number" value="25" step="any"/><label for="rh">相対湿度（%）</label><input id="rh" type="number" value="70" min="1" max="100" step="any"/><button id="simulate">シミュレーションする ↗</button><output id="result" aria-live="polite">条件を入力して計算してください。</output></section><section class="panel sim-chart"><span class="kicker">02 / VISUALIZATION</span><h2>気温の鉛直変化</h2><div class="chart-wrap"><svg id="chart" viewBox="0 0 500 290" role="img" aria-label="高度に対する気温の概略グラフ"><rect width="500" height="290" rx="14" fill="#f4f8fd"/><path d="M45 22V250H480" fill="none" stroke="#aabbd0" stroke-width="1.5"/><text x="18" y="20" font-size="12" fill="#536985">高度</text><text x="415" y="273" font-size="12" fill="#536985">気温</text><polyline id="curve" points="" fill="none" stroke="#0369a1" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg></div><p class="muted">青い線：教育用近似モデルによる気温変化</p></section></div><section class="panel disclaimer"><h2>このモデルについて</h2><p>乾燥断熱減率9.8 ℃/km、雲底近似125 m/℃、雲底上は固定6 ℃/kmを使った教育用モデルです。実際の気象予測には使用できません。</p></section></Base>
<style>.sim-grid{display:grid;grid-template-columns:.82fr 1.18fr;gap:20px;align-items:start}.sim-grid .panel{margin:0;min-height:410px}.kicker{font-size:.72rem;color:var(--accent);font-weight:800;letter-spacing:.15em}.sim-grid h2{font-size:1.2rem;margin:12px 0 24px}.sim-controls{display:grid;gap:12px}.sim-controls label{font-size:.85rem;color:#52647c}.sim-controls input{width:100%;background:#f8fafc}.sim-controls button{margin-top:8px}.sim-controls output{font-size:.9rem;line-height:1.8;background:var(--accent-light);border-radius:12px;padding:15px;margin-top:5px}.chart-wrap{width:100%;overflow:hidden}.chart-wrap svg{width:100%;height:auto;display:block}.sim-chart .muted{font-size:.75rem}.disclaimer{margin-top:20px}.disclaimer h2{font-size:1.1rem}.disclaimer p{font-size:.85rem;color:#66778e;line-height:1.9}@media(max-width:800px){.sim-grid{grid-template-columns:1fr}.sim-grid .panel{min-height:0}}</style>
<script>
import {parcelProfile,dewPoint} from '../lib/weather.mjs';
document.getElementById('simulate')?.addEventListener('click',()=>{const t=Number(document.getElementById('temp').value),rh=Number(document.getElementById('rh').value);try{if(document.getElementById('temp').value===''||document.getElementById('rh').value==='')throw Error('empty');const p=parcelProfile(t,rh);document.getElementById('result').textContent='露点：'+dewPoint(t,rh).toFixed(1)+' ℃\n推定雲底：'+p.lclM.toFixed(0)+' m';const pts=p.points.map(x=>[55+(t-x.tempC)*7,245-x.heightM/5000*200]);document.getElementById('curve').setAttribute('points',pts.map(p=>p.join(',')).join(' '))}catch(e){document.getElementById('result').textContent='入力値を確認してください'}})
</script>