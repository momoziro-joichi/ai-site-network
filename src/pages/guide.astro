---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import {curricula} from '../config/curricula.mjs';
const key=process.env.SITE_KEY||'weather',data=curricula[key];
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<Base title="学習ガイド"><PageIntro eyebrow="LEARNING ROADMAP" title="学習ガイド" description={data.description} number="≡"/><div class="roadmap">{data.tracks.map(([name,description],i)=><article class="panel chapter"><span class="chapter-no">STEP {String(i+1).padStart(2,'0')}</span><h2>{name}</h2><p>{description}</p></article>)}</div><section class="panel"><h2>実際に試す</h2><div class="resources">{data.links.map(([name,path])=><a href={base+path}>{name} ↗</a>)}</div><p class="muted">このページは学習順序の案内です。掲載していない分野について、教材が完成したように表示していません。</p></section></Base>
<style>.roadmap{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.chapter{margin:0;min-height:220px}.chapter-no{font-size:.7rem;color:var(--accent);letter-spacing:.14em;font-weight:800}.chapter h2{margin:15px 0}.chapter p{color:var(--muted);font-size:.87rem;line-height:1.9}.resources{display:flex;gap:12px;flex-wrap:wrap}.resources a{padding:12px 15px;background:var(--accent-light);text-decoration:none;border-radius:12px;font-weight:700;font-size:.85rem}.muted{margin-top:20px;font-size:.8rem}@media(max-width:800px){.roadmap{grid-template-columns:1fr}}</style>