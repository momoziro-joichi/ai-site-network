---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
---
<Base title="鉄道走行性能ラボ"><PageIntro eyebrow="RAIL PERFORMANCE LAB" title="鉄道走行性能ラボ" description="駅間距離と加減速度を変えて、列車の速度推移と所要時間を比較します。" number="↗"/><section class="panel"><div class="rail-grid"><div class="inputs"><label for="distance">駅間距離（km）</label><input id="distance" type="number" value="8" min="0.1" step="0.1"/><label for="speed">最高速度（km/h）</label><input id="speed" type="number" value="120" min="1"/><label for="accel">加速度（m/s²）</label><input id="accel" type="number" value="0.6" min="0.01" step=".05"/><label for="decel">減速度（m/s²）</label><input id="decel" type="number" value="0.7" min="0.01" step=".05"/><output id="result" aria-live="polite"></output></div><div><svg id="graph" viewBox="0 0 600 360" role="img" aria-label="速度時間グラフ"><rect width="600" height="360" rx="16" fill="#f3f8fb"/><path d="M50 25V310H570" fill="none" stroke="#728399" stroke-width="2"/><path id="profile" fill="none" stroke="#047857" stroke-width="4"/><text x="15" y="20" font-size="13" fill="#53657a">速度</text><text x="475" y="338" font-size="13" fill="#53657a">時間 →</text></svg><p class="muted">発車時と到着時の速度を0とし、一定加速度・一定減速度を仮定。勾配、曲線、速度制限、信号、余裕時分は考慮しません。</p></div></div></section></Base>
<style>.rail-grid{display:grid;grid-template-columns:260px 1fr;gap:24px}.inputs{display:grid;gap:10px;align-content:start}.inputs input{width:100%}.inputs label{font-size:.83rem}.inputs output{white-space:pre-line;line-height:2;color:var(--accent);font-weight:700;margin-top:12px}svg{width:100%;height:auto}.muted{font-size:.78rem;color:var(--muted)}@media(max-width:700px){.rail-grid{grid-template-columns:1fr}}</style>
<script>
import {journey} from '../lib/science.mjs';
const el=id=>document.getElementById(id);
function render(){try{const ids=['distance','speed','accel','decel'];if(ids.some(id=>el(id).value===''))throw Error('empty');const [d,s,a,b]=ids.map(id=>Number(el(id).value));const result=journey(d,s,a,b),peak=result.peakKmh/3.6,t1=peak/a,t3=peak/b,t2=Math.max(0,result.seconds-t1-t3),total=result.seconds;el('result').textContent='理論走行時間：'+(total/60).toFixed(2)+'分\n到達最高速度：'+result.peakKmh.toFixed(1)+'km/h';const px=t=>50+t/Math.max(total,.001)*520,py=v=>310-v/Math.max(s/3.6,.001)*255;el('profile').setAttribute('d','M'+px(0)+' '+py(0)+' L'+px(t1)+' '+py(peak)+' L'+px(t1+t2)+' '+py(peak)+' L'+px(total)+' '+py(0))}catch{el('result').textContent='正しい数値を入力してください';el('profile').setAttribute('d','')}}
['distance','speed','accel','decel'].forEach(id=>el(id).addEventListener('input',render));render();
</script>