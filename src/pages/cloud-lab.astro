---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
---
<Base title="雲の実験室"><PageIntro eyebrow="CLOUD FORMATION LAB" title="雲の実験室" description="地上気温・相対湿度・上昇高度を変えて、気塊が冷える様子を観察します。" number="☁"/><section class="panel"><div class="cloud-grid"><div class="cloud-controls"><label for="temp">地上気温（℃）</label><input id="temp" type="range" min="-10" max="40" value="25"/><output id="temp-val"></output><label for="humidity">相対湿度（%）</label><input id="humidity" type="range" min="10" max="100" value="70"/><output id="humidity-val"></output><label for="height">上昇高度（m）</label><input id="height" type="range" min="0" max="5000" step="100" value="1000"/><output id="height-val"></output></div><div class="cloud-visual"><div class="sky"><div id="cloud" class="cloud" aria-hidden="true">☁</div><div id="parcel" class="parcel" aria-hidden="true">↑</div></div><output id="reading" aria-live="polite"></output></div></div><p class="muted">露点はMagnus式で近似し、雲底高度は125×（気温−露点）mで推定。雲底より上の気温減率は6 ℃/kmに固定した教育用近似です。雲の有無を実際に予報するものではありません。</p></section></Base>
<style>.cloud-grid{display:grid;grid-template-columns:280px 1fr;gap:30px}.cloud-controls{display:grid;gap:10px;align-content:start}.cloud-controls input{width:100%}.cloud-controls output{font-size:.8rem;color:var(--accent);margin:0}.sky{position:relative;min-height:260px;overflow:hidden;border-radius:18px;background:linear-gradient(#78b9e9,#d9edfc);display:grid;place-items:center}.cloud{font-size:7rem;opacity:.15;transition:opacity .25s;filter:drop-shadow(0 8px 10px #fff)}.parcel{position:absolute;bottom:15px;font-size:2rem;color:#fff}.cloud-visual output{font-size:.94rem}.muted{font-size:.77rem;margin-top:24px}@media(max-width:750px){.cloud-grid{grid-template-columns:1fr}}</style>
<script>
import {dewPoint,approximateCloudBase} from '../lib/weather.mjs';
const el=id=>document.getElementById(id);
function render(){const t=Number(el('temp').value),rh=Number(el('humidity').value),h=Number(el('height').value);const td=dewPoint(t,rh),base=approximateCloudBase(t,td);const estimate=t-.0098*Math.min(h,base)-.006*Math.max(0,h-base);el('temp-val').textContent=t+' ℃';el('humidity-val').textContent=rh+' %';el('height-val').textContent=h+' m';el('cloud').style.opacity=h>=base?'.9':'.13';el('parcel').style.bottom=(10+h/5000*80)+'%';el('reading').textContent='推定雲底 '+base.toFixed(0)+' m ／ 高度'+h+' mでの気温 '+estimate.toFixed(1)+' ℃';}
for(const id of ['temp','humidity','height'])el(id).addEventListener('input',render);render();
</script>