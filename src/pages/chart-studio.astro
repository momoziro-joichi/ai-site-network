---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
---
<Base title="天気図読解ワークスペース"><PageIntro eyebrow="SYNOPTIC ANALYSIS STUDIO" title="天気図読解ワークスペース" description="公式天気図を別タブで確認しながら、気圧配置・前線・移動方向を自分で書き込み、考察を保存できます。" number="✎"/><section class="panel"><div class="workspace-actions"><a href="https://www.jma.go.jp/bosai/weather_map/" target="_blank" rel="noopener noreferrer">気象庁の天気図を開く ↗</a><label for="tool">描画ツール</label><select id="tool"><option value="pen">ペン</option><option value="H">高気圧 H</option><option value="L">低気圧 L</option><option value="cold">寒冷前線</option><option value="warm">温暖前線</option><option value="arrow">移動方向 →</option><option value="erase">消しゴム</option></select><label for="color">色</label><input type="color" id="color" value="#174d9b"/><button type="button" id="undo">一つ戻す</button><button type="button" id="clear">全消去</button><button type="button" id="export">PNG保存</button></div><p class="muted">白紙の分析キャンバスです。公式天気図の画像を自動転載するものではありません。気象庁の図を見て、気圧配置を自分で再現してください。</p><div class="canvas-wrap"><canvas id="analysis" width="1000" height="620" aria-label="天気図の書き込みキャンバス"></canvas></div><div class="notes"><label for="notes">考察メモ</label><textarea id="notes" rows="6" placeholder="例：低気圧の中心位置、前線の伸びる方向、今後の変化を根拠とともに記録"></textarea><button id="save-notes" type="button">メモをこの端末に保存</button><output id="status" aria-live="polite"></output></div></section><section class="panel"><h2>読解のチェックポイント</h2><ol><li>天気図の発表時刻と対象領域を確認する。</li><li>高気圧・低気圧の中心と気圧値を確認する。</li><li>前線の種類・位置を読み取る。</li><li>複数時刻の図を比較して移動を確認する。</li><li>観測事実と予想・自分の解釈を区別してメモする。</li></ol><p class="muted">この機能は学習用です。防災判断には気象庁の最新の警報・注意報・気象情報を確認してください。</p></section></Base>
<style>.workspace-actions{display:flex;align-items:center;flex-wrap:wrap;gap:10px}.workspace-actions label{font-size:.8rem}.workspace-actions button,.workspace-actions a{font-size:.8rem;padding:10px 13px}.canvas-wrap{overflow:auto;background:#e5edf4;border:1px solid var(--line);border-radius:16px;margin-top:18px;touch-action:none}.canvas-wrap canvas{display:block;width:100%;height:auto;touch-action:none;cursor:crosshair;background:#fff}.notes{display:grid;gap:10px;margin-top:20px}.notes textarea{width:100%}.notes button{justify-self:start}.muted{font-size:.79rem;color:var(--muted);line-height:1.8}</style>
<script>
const canvas=document.getElementById('analysis'),ctx=canvas.getContext('2d'),tool=document.getElementById('tool'),color=document.getElementById('color');let operations=[],drawing=null;const store='ai-site-network-chart-annotations-v1';
try{const saved=JSON.parse(localStorage.getItem(store)||'[]');if(Array.isArray(saved))operations=saved.slice(0,2000)}catch{}
function pos(e){const r=canvas.getBoundingClientRect();return{x:(e.clientX-r.left)*canvas.width/r.width,y:(e.clientY-r.top)*canvas.height/r.height}}
function render(){ctx.fillStyle='#fff';ctx.fillRect(0,0,canvas.width,canvas.height);ctx.strokeStyle='#e4edf5';ctx.lineWidth=1;for(let x=0;x<1000;x+=50){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,620);ctx.stroke()}for(let y=0;y<620;y+=50){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(1000,y);ctx.stroke()}ctx.font='15px sans-serif';ctx.fillStyle='#9aaac0';ctx.fillText('学習用・白紙キャンバス（地図投影ではありません）',22,35);for(const o of [...operations,...(drawing?[drawing]:[])]){ctx.lineWidth=o.type==='erase'?26:4;ctx.lineCap='round';ctx.lineJoin='round';ctx.strokeStyle=o.type==='erase'?'#fff':o.color;ctx.fillStyle=o.color;if(o.type==='pen'||o.type==='erase'){ctx.beginPath();o.points.forEach((p,i)=>i?ctx.lineTo(p.x,p.y):ctx.moveTo(p.x,p.y));ctx.stroke()}else{ctx.font='bold 32px sans-serif';const symbols={H:'H',L:'L',cold:'▲▲▲',warm:'●●●',arrow:'→'};ctx.fillText(symbols[o.type]||'',o.x,o.y)}}}
function persist(){try{localStorage.setItem(store,JSON.stringify(operations.slice(-1000)))}catch{}}
canvas.addEventListener('pointerdown',e=>{e.preventDefault();canvas.setPointerCapture(e.pointerId);const p=pos(e);drawing=tool.value==='pen'||tool.value==='erase'?{type:tool.value,color:color.value,points:[p]}:{type:tool.value,color:color.value,...p};render()});
canvas.addEventListener('pointermove',e=>{if(!drawing||!drawing.points)return;drawing.points.push(pos(e));render()});
function finish(){if(!drawing)return;operations.push(drawing);drawing=null;persist();render()}canvas.addEventListener('pointerup',finish);canvas.addEventListener('pointercancel',finish);
document.getElementById('undo').addEventListener('click',()=>{operations.pop();persist();render()});document.getElementById('clear').addEventListener('click',()=>{if(confirm('書き込みをすべて消去しますか？')){operations=[];persist();render()}});document.getElementById('export').addEventListener('click',()=>{const a=document.createElement('a');a.download='weather-chart-study.png';a.href=canvas.toDataURL('image/png');a.click()});
const note=document.getElementById('notes');try{note.value=localStorage.getItem('ai-site-network-chart-notes')||''}catch{}document.getElementById('save-notes').addEventListener('click',()=>{try{localStorage.setItem('ai-site-network-chart-notes',note.value);document.getElementById('status').textContent='この端末に保存しました'}catch{document.getElementById('status').textContent='保存できませんでした'}});render();
</script>