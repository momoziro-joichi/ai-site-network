---
const {eyebrow='EXPLORE',title,description,number}=Astro.props;
---
<section class="page-intro"><div class="intro-copy"><p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p class="description">{description}</p></div><div class="intro-art" aria-hidden="true"><span class="art-ring"></span><span class="art-ring art-ring-two"></span><span class="art-glyph">{number??'✦'}</span></div></section>
<style>
.page-intro{position:relative;overflow:hidden;display:flex;justify-content:space-between;align-items:center;gap:25px;padding:39px clamp(24px,5vw,52px);border-radius:26px;background:linear-gradient(115deg,#fff 30%,color-mix(in srgb,var(--accent) 10%,white));border:1px solid #e2eaf2;margin-bottom:27px;min-height:230px}
.eyebrow{font-size:.7rem;letter-spacing:.18em;color:var(--accent);font-weight:800;margin:0 0 11px}
h1{font-size:clamp(1.75rem,3.6vw,2.75rem);margin:0 0 12px;line-height:1.35}
.description{color:#66778e;font-size:.89rem;max-width:600px;margin:0;line-height:1.95}
.intro-art{flex:0 0 180px;height:160px;position:relative;display:grid;place-items:center}
.art-ring{position:absolute;width:140px;height:140px;border:1px solid color-mix(in srgb,var(--accent) 28%,white);border-radius:50%}.art-ring-two{width:190px;height:190px;border-style:dashed;opacity:.65}
.art-glyph{width:95px;height:95px;border-radius:27px;display:grid;place-items:center;background:var(--accent);color:white;font-size:2.7rem;font-weight:800;box-shadow:0 16px 35px color-mix(in srgb,var(--accent) 23%,transparent);transform:rotate(-8deg)}
@media(max-width:600px){.page-intro{padding:28px 23px;min-height:0}.intro-art{display:none}}
</style>