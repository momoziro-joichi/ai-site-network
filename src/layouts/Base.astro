---
import { sites } from '../config/sites.js';
import Utilities from '../components/Utilities.astro';
const key=process.env.SITE_KEY||'weather';
const site=sites[key];
const {title=site.name,description=site.description}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const href=(p)=>base+p;
const isPages=process.env.GITHUB_PAGES==='true';
const icon={weather:'◉',math:'∑',rail:'⌁',english:'Aa',tools:'✦'}[key];
---
<!doctype html>
<html lang="ja" data-site={key}>
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="theme-color" content={site.color}/>
<title>{title}</title>
<meta name="description" content={description}/>
{!isPages&&site.url.includes('example.com')&&<meta name="robots" content="noindex,nofollow"/>}
<style is:global define:vars={{accent:site.color}}>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@400;500;600;700;800&display=swap');
:root{font-family:'DM Sans','Noto Sans JP',system-ui,sans-serif;color:#162338;background:#f7f9fc;line-height:1.75;font-synthesis:none;--ink:#162338;--muted:#62728a;--line:#e3eaf2;--surface:#fff;--accent-light:color-mix(in srgb,var(--accent) 9%,white)}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;min-width:320px;background:radial-gradient(ellipse 75% 400px at 90% -120px,color-mix(in srgb,var(--accent) 12%,transparent),transparent),#f7f9fc}
a{color:var(--accent);text-underline-offset:3px}
a:hover{text-decoration-color:transparent}
a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
.site-header{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.9);backdrop-filter:blur(18px);border-bottom:1px solid rgba(218,228,238,.85)}
.site-nav{max-width:1140px;margin:auto;padding:13px 28px;display:flex;justify-content:space-between;align-items:center;gap:24px}
.brand{display:flex;align-items:center;gap:11px;text-decoration:none;color:var(--ink);font-weight:800;letter-spacing:-.035em;white-space:nowrap;font-size:.98rem}
.brand-mark{width:37px;height:37px;border-radius:12px;display:grid;place-items:center;background:var(--accent);color:white;font-size:1.1rem;box-shadow:0 7px 16px color-mix(in srgb,var(--accent) 24%,transparent)}
.nav-links{display:flex;gap:5px;flex-wrap:wrap;justify-content:flex-end}
.nav-links a{font-size:.82rem;font-weight:700;color:#56657a;text-decoration:none;padding:9px 12px;border-radius:10px;transition:background .2s,color .2s}
.nav-links a:hover{background:var(--accent-light);color:var(--accent)}
main{max-width:1120px;margin:auto;padding:42px 28px 90px;min-height:73vh}
h1,h2,h3{line-height:1.35;letter-spacing:-.04em;color:var(--ink)}
h1{font-size:clamp(2rem,5vw,3.8rem);font-weight:800}
h2{font-size:clamp(1.25rem,2.6vw,1.75rem)}
p{margin:0 0 1em}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:22px;padding:clamp(22px,3vw,34px);margin:20px 0;box-shadow:0 8px 30px rgba(30,56,90,.035)}
.tool{display:grid;gap:16px;max-width:600px}
label{font-weight:600}
input,button,textarea,select{font:inherit;padding:12px 14px;border:1px solid #cbd6e2;border-radius:12px;max-width:100%}
input,textarea,select{background:white;color:var(--ink)}
button,.primary-action{background:var(--accent);color:white;cursor:pointer;border:0;font-weight:700;box-shadow:0 8px 18px color-mix(in srgb,var(--accent) 18%,transparent);transition:transform .2s,box-shadow .2s}
button:hover,.primary-action:hover{transform:translateY(-2px);box-shadow:0 12px 25px color-mix(in srgb,var(--accent) 25%,transparent)}
output{display:block;white-space:pre-wrap;font-weight:700;margin-top:12px}
.muted{color:var(--muted)}
.ad{border:1px dashed #c6d1dd;border-radius:14px;padding:16px;text-align:center;color:var(--muted);font-size:.8rem}
.site-footer{border-top:1px solid var(--line);background:#fff}
.footer-inner{max-width:1120px;margin:auto;padding:28px;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:.83rem;color:var(--muted)}
.footer-inner a{color:#4b5d75;text-decoration:none}
.footer-inner p{margin:0}
fieldset{border:1px solid var(--line);border-radius:14px;margin:12px 0;padding:18px}
@media(max-width:760px){.site-nav{padding:12px 18px;align-items:flex-start;flex-direction:column;gap:10px}.nav-links{width:100%;flex-wrap:nowrap;overflow-x:auto;justify-content:flex-start;padding-bottom:2px}.nav-links a{white-space:nowrap;padding:7px 10px}main{padding:30px 18px 60px}.brand{font-size:.9rem}.panel{border-radius:18px}.footer-inner{padding:25px 18px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{transition:none!important;animation:none!important}}
html[data-theme='dark']{color-scheme:dark;--ink:#ecf3fc;--muted:#a7b5c8;--line:#33435a;--surface:#1c293c;--accent-light:color-mix(in srgb,var(--accent) 22%,#1c293c);background:#111b2b;color:#ecf3fc}html[data-theme='dark'] body{background:#111b2b;color:#ecf3fc}html[data-theme='dark'] .site-header,html[data-theme='dark'] .site-footer{background:#172337;border-color:#33435a}html[data-theme='dark'] .brand,html[data-theme='dark'] .nav-links a,html[data-theme='dark'] .footer-inner a{color:#ecf3fc}html[data-theme='dark'] .panel,html[data-theme='dark'] .feature-card,html[data-theme='dark'] .page-intro{background:#1c293c;border-color:#33435a}html[data-theme='dark'] input,html[data-theme='dark'] select,html[data-theme='dark'] textarea{background:#25364b;color:#f3f7fc;border-color:#51617a}html[data-theme='dark'] .hero-visual,html[data-theme='dark'] .result-surface{background:#25364b}html[data-theme='dark'] .feature-card h3,html[data-theme='dark'] .page-intro h1{color:#ecf3fc}
</style>
</head>
<body>
<header class="site-header"><nav class="site-nav" aria-label="メインナビゲーション">
<a class="brand" href={href('/')}><span class="brand-mark" aria-hidden="true">{icon}</span><span>{site.name}</span></a>
<div class="nav-links">
<a href={href('/tool/')}>ツール</a><a href={href('/lab/')}>実験室</a><a href={href('/guide/')}>ガイド</a>
{key==='weather'&&<><a href={href('/learn/')}>教科書</a><a href={href('/quiz/')}>問題</a><a href={href('/simulator/')}>シミュレーター</a><a href={href('/live-weather/')}>最新予報</a><a href={href('/official-charts/')}>実況天気図</a><a href={href('/chart-studio/')}>天気図演習</a><a href={href('/weather-map/')}>天気図</a><a href={href('/cloud-lab/')}>雲の実験</a></>}
</div><Utilities /></nav></header>
<main id="content"><slot/></main>
<footer class="site-footer"><div class="footer-inner"><p>© {new Date().getFullYear()} {site.name}</p><div><a href={href('/about/')}>運営情報</a>　·　<a href={href('/privacy/')}>プライバシー</a></div></div></footer>
</body></html>