---
import { sites } from '../config/sites.js';
const key=process.env.SITE_KEY||'weather';
const site=sites[key];
const {title=site.name,description=site.description}=Astro.props;
---
<!doctype html><html lang="ja"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/>{site.url.includes('example.com')&&<meta name="robots" content="noindex,nofollow"/>}<style is:global define:vars={{accent:site.color}}>:root{font-family:system-ui,sans-serif;color:#172033;background:#f6f8fb}*{box-sizing:border-box}body{margin:0}header,footer{background:#fff}nav,main,footer>div{max-width:940px;margin:auto;padding:20px}nav{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}nav a{margin-right:12px}a{color:var(--accent)}main{min-height:75vh}.panel{background:white;border:1px solid #dbe4ed;border-radius:14px;padding:22px;margin:20px 0}.tool{display:grid;gap:12px;max-width:540px}input,button,textarea,select{font:inherit;padding:10px;border:1px solid #a9b7c6;border-radius:8px}button{background:var(--accent);color:white;cursor:pointer}output{display:block;white-space:pre-wrap;font-weight:600;margin-top:12px}.muted{color:#526175}.ad{border:1px dashed #aab7c7;padding:16px;text-align:center}</style></head><body><header><nav><a href="/"><strong>{site.name}</strong></a><div><a href="/tool/">ツール</a><a href="/lab/">実験室</a><a href="/guide/">ガイド</a>{key==='weather'&&<><a href="/learn/">教科書</a><a href="/quiz/">問題</a><a href="/simulator/">シミュレーター</a></>}</div></nav></header><main><slot/></main><footer><div><a href="/about/">運営情報</a> · <a href="/privacy/">プライバシー</a><p>© {new Date().getFullYear()} {site.name}</p></div></footer></body></html>